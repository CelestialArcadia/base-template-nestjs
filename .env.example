# Copy to .env and fill in. .env is gitignored — never commit real values.
NODE_ENV=development

APPNAME=Cluster0
APPVERSION=v1.0
APP_PORT=3000

# For the docker-compose Mongo replica set, the in-cluster URI works as-is:
MONGO_ATLAS_DB_NAME=mongodb-primary
MONGO_ATLAS_DB_URI=mongodb://root:CHANGE_ME@mongodb-primary:27017
# Or point at MongoDB Atlas:
# MONGO_ATLAS_DB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
