# Copy to apps/billing/.env — gitignored, never commit real values.
RABBIT_MQ_URI=amqp://rabbitmq:5672
RABBIT_MQ_BILLING_QUEUE=billing

# Billing's invoice ledger — the local compose Postgres. Local dev password only.
# Repoint at any hosted Postgres (Neon, RDS, …) to run the demo against a cloud DB.
DATABASE_URL=postgresql://billing:CHANGE_ME@postgres:5432/billing?schema=public

# Billing stores nothing in Mongo, but the @app/common barrel connects eagerly.
# See the note in billing.module.ts — required until db.module.ts is refactored.
MONGO_ATLAS_DB_URI=mongodb://root:CHANGE_ME@mongodb-primary:27017
