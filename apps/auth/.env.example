# Copy to apps/auth/.env — gitignored, never commit real values.
MONGODB_URI=mongodb://root:CHANGE_ME@mongodb-primary:27017

# Generate strong secrets, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME
JWT_REFRESH_TOKEN_SECRET=CHANGE_ME
JWT_EXPIRATION=3600
JWT_REFRESH_TOKEN_EXPIRATION=604800
